{
  "name": "rubezh",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/core/**' --coverage.thresholds.80 --coverage.reporter=json --coverage.reporter=text --coverage.reportsDirectory=dist/coverage",
    "test:smoke": "playwright test",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:mutation": "stryker run",
    "build": "vite build",
    "prepare": "husky",
    "lint": "eslint src scripts e2e \"playwright*.config.ts\"",
    "lint:fix": "eslint src scripts e2e \"playwright*.config.ts\" --fix",
    "format": "prettier --write src index.html \"scripts/**/*.{ts,mjs}\" e2e \"playwright*.config.ts\" AGENTS.md README.md",
    "format:check": "prettier --check src index.html \"scripts/**/*.{ts,mjs}\" e2e \"playwright*.config.ts\" AGENTS.md README.md",
    "docs": "typedoc"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "./playwright*.config.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css}": [
      "prettier --write"
    ],
    "AGENTS.md": [
      "prettier --write"
    ],
    "./README.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.7",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
